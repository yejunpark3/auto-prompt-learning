# 복사해서 .env로 쓴다: cp .env.example .env

# litellm 모델 문자열. 로컬 서버는 `openai/` 접두사를 붙인다. `:think`는 thinking 켠 변형.
LLM_MODEL=openai/mlx-community/Qwen3.5-9B-OptiQ-4bit:think

# 로컬에서 `optiq serve`로 띄워 둔 서버. 비우면 호스팅 모델로 호출한다(litellm이 환경변수 키를 쓴다).
LLM_API_BASE=http://127.0.0.1:8080/v1

# 로컬 서버(LLM_API_BASE)로 보내는 키. optiq serve는 'sk-optiq-' 접두사를 요구한다. mlx_lm.server는 검사하지 않는다.
API_KEY=sk-optiq-local

# 샘플링 온도. 비우면 1.0(Qwen3.5 thinking 권장값). 다른 모델에서 비문·반복이 나면 0.6 안팎으로 낮춘다.
# LLM_TEMPERATURE=1.0

# 로컬 서버(LLM_API_BASE)에 요청마다 보내는 추가 필드(JSON). 기본은 {"top_k": 20, "presence_penalty": 0.5}이고,
# 여기에 적은 키가 덮어쓰거나 더해진다. vLLM이면 min_p, frequency_penalty, repetition_penalty 등도 된다.
# LLM_EXTRA_BODY={"presence_penalty": 0, "min_p": 0.05}

# 한 발화의 최대 문장 수(넘으면 뒤를 자른다. 통화를 끊는 발화는 자르지 않는다). 비우면 둘 다 2.
# CALLER_MAX_SENTENCES=2
# CALLEE_MAX_SENTENCES=2

# 수신자 프롬프트의 [Background]에 페르소나 서술 필드를 넣을지. 기본은 켜짐(정체성·uuid를 뺀 서술 필드 전부).
# 0이면 정체성 필드 9개만 넣는다. 14B 기준 비교(시드 31, 같은 수신자 8명)에서 힌트 없이 전체를 넣은 팔은
# 9필드보다 나빠 보였지만(발화 채점 1.24→0.82, 루프 2→4) 같은 설정을 다시 돌려도 그 정도 변동이 나왔고
# (3개 추가 0.62 대 3개 추가+힌트 1.25), 힌트를 켠 전체 팔은 9필드와 같은 수준(1.29 대 1.31)이었다.
# 필드를 골라 넣으려면 아래처럼 쉼표로 적는다(PERSONA_BACKGROUND보다 우선한다).
# PERSONA_BACKGROUND=1
# PERSONA_BACKGROUND_FIELDS=family_persona,hobbies_and_interests,culinary_persona

# 같은 화자가 직전 발화와 60% 이상 닮은 말을 되풀이하면 그 화자의 다음 차례에 한 번
# "같은 말이 되풀이되고 있다, 더 할 말이 없으면 end_call로 끝내라"는 힌트를 준다(기본 켜짐).
# 90% 이상 닮은(거의 똑같은) 첫 되풀이도 바로 끊지 않고 그 화자에게 힌트를 한 번 준다.
# 힌트를 받은 화자가 또 90% 이상 되풀이하면 그때 repetition_loop로 끝낸다.
# 근거: 루프 통화에서 힌트를 붙이면 end_call 24%→60%(한 턴 시험), 서술을 추가한 풀콜에서 루프 8/16→0/15.
# 끄려면 LOOP_NUDGE=0.
# LOOP_NUDGE=1

# 학습자(learner.py)가 위키를 고치게 할지. 기본 0(끔). 5회 실측에서 14B 학습자가 위키에 쓴 내용은 지어낸 사실·중복이었고
# 발신자가 통화에서 그대로 따라 말했다. 1이면 켠다(사실 검사기는 재현율 한계가 있어 지어낸 내용을 다 막지 못한다).
# LEARN_WIKI_WRITES=0
